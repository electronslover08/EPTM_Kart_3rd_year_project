.................... ==== Fonction: int Adc_read(int channel) 
.................... ==== Déscription: Convertit en digital 8 bits le canal analog.          ==== 
.................... ==== passé en param. Paramètres d'entrée: channel: soit le canal        ==== 
.................... ==== à convertir Paramètres de sortie: valeur num. 8 bits de l'entrée   ==== 
.................... ==== analog. AN0                                                        ==== 
.................... ============================================================================ */ 
.................... int adc_read(int channel) 
.................... { 
.................... 	ADCON0 = (channel << 2) + 0b00000001; 
*
1182:  RLCF   5B,W
1184:  MOVWF  00
1186:  RLCF   00,F
1188:  MOVLW  FC
118A:  ANDWF  00,F
118C:  MOVF   00,W
118E:  ADDLW  01
1190:  MOVWF  FC2
....................  
.................... 	ADGO = 1; 
1192:  BSF    FC2.1
.................... 	while(ADGO==1) 
.................... 		continue; 
1194:  BTFSS  FC2.1
1196:  BRA    119C
1198:  BRA    1194
119A:  BRA    1194
.................... 	return (ADRESH); 
119C:  MOVFF  FC4,01
.................... } 
11A0:  RETURN 0
