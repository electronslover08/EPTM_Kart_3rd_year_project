....................  
.................... void BlockRead(void) 
.................... { 
.................... 	startReading(); 
*
1D22:  RCALL  1CC2
.................... 	//récupère les valeurs de l'écran tactile 
.................... 	for(index=0; index<4; index++){ DataRecu[index] = i2c_read();} 
1D24:  CLRF   71
1D26:  MOVF   71,W
1D28:  SUBLW  03
1D2A:  BNC   1D48
1D2C:  CLRF   03
1D2E:  MOVF   71,W
1D30:  ADDLW  D3
1D32:  MOVWF  FE9
1D34:  MOVLW  00
1D36:  ADDWFC 03,W
1D38:  MOVWF  FEA
1D3A:  MOVLW  01
1D3C:  MOVWF  00
1D3E:  RCALL  1D06
1D40:  MOVFF  01,FEF
1D44:  INCF   71,F
1D46:  BRA    1D26
....................  
.................... 	DataRecu[4] = i2c_read(0); 
1D48:  CLRF   00
1D4A:  RCALL  1D06
1D4C:  MOVFF  01,D7
.................... 	i2c_stop(); 
1D50:  BSF    FC5.2
1D52:  BTFSC  FC5.2
1D54:  BRA    1D52
1D56:  RETURN 0
.................... } 
