.................... void startReading(void) 
.................... { 
.................... 	int ack; 
.................... 	i2c_start(); 
*
1CC2:  BSF    FC5.0
1CC4:  BTFSC  FC5.0
1CC6:  BRA    1CC4
.................... 	 
.................... 	do{ ack = i2c_write(I2CADDRESS);} while(ack == 1); 
1CC8:  MOVLW  88
1CCA:  MOVWF  xFF
1CCC:  CALL   07E0
1CD0:  MOVFF  01,F7
1CD4:  DECFSZ xF7,W
1CD6:  BRA    1CDA
1CD8:  BRA    1CC8
.................... 	do{ ack = i2c_write(0x04);}		  while(ack == 1);	// dis qu'on veut "Read Block" 
1CDA:  MOVLW  04
1CDC:  MOVWF  xFF
1CDE:  CALL   07E0
1CE2:  MOVFF  01,F7
1CE6:  DECFSZ xF7,W
1CE8:  BRA    1CEC
1CEA:  BRA    1CDA
.................... 	//------------- 
.................... 	i2c_start(); 
1CEC:  BSF    FC5.1
1CEE:  BTFSC  FC5.1
1CF0:  BRA    1CEE
.................... 	do{ ack = i2c_write(I2CADDRESS+1);}  while(ack == 1); 
1CF2:  MOVLW  89
1CF4:  MOVWF  xFF
1CF6:  CALL   07E0
1CFA:  MOVFF  01,F7
1CFE:  DECFSZ xF7,W
1D00:  BRA    1D04
1D02:  BRA    1CF2
1D04:  RETURN 0
.................... } 
.................... void iDe(int end_xh,int end_xl, int end_yh, int end_yl) 
.................... { 
.................... 	for(index=0; index<3; index++){	i2c_write(iDe_tab[index]);} 
*
0872:  CLRF   71
0874:  MOVF   71,W
0876:  SUBLW  02
0878:  BNC   0896
087A:  CLRF   03
087C:  MOVF   71,W
087E:  ADDLW  68
0880:  MOVWF  FE9
0882:  MOVLW  00
0884:  ADDWFC 03,W
0886:  MOVWF  FEA
0888:  MOVFF  FEF,FC
088C:  MOVFF  FC,FF
0890:  RCALL  07E0
0892:  INCF   71,F
0894:  BRA    0874
.................... 	i2c_write(end_xh);	//Comme l'écran est grand, sa taille se donne sur  
0896:  MOVFF  F8,FF
089A:  RCALL  07E0
.................... 	i2c_write(end_xl);	//2 Byte. C'est pour ça que les coordonnées sont en 2 fois 
089C:  MOVFF  F9,FF
08A0:  RCALL  07E0
.................... 	i2c_write(end_yh);	//La ligne part de la position du curseur jusqu'à la position  
08A2:  MOVFF  FA,FF
08A6:  RCALL  07E0
.................... 	i2c_write(end_yl);	//entrée dans la fonction 
08A8:  MOVFF  FB,FF
08AC:  RCALL  07E0
08AE:  RETURN 0
.................... } 
