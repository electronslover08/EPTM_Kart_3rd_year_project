.................... //  Description: écris un texte 
.................... //------------------------------------------------------------------------- 
.................... void iDT(int phrase[]) 
.................... { 
.................... 	for(index=0; index<3; index++){	i2c_write(idt_tab[index]);} 
090E:  CLRF   71
0910:  MOVF   71,W
0912:  SUBLW  02
0914:  BNC   0932
0916:  CLRF   03
0918:  MOVF   71,W
091A:  ADDLW  4A
091C:  MOVWF  FE9
091E:  MOVLW  00
0920:  ADDWFC 03,W
0922:  MOVWF  FEA
0924:  MOVFF  FEF,FA
0928:  MOVFF  FA,FF
092C:  RCALL  07E0
092E:  INCF   71,F
0930:  BRA    0910
.................... 	 
.................... 	index = 0; 
0932:  CLRF   71
.................... 	while(phrase[index]!=0){ 
0934:  MOVF   71,W
0936:  ADDWF  xF8,W
0938:  MOVWF  FE9
093A:  MOVLW  00
093C:  ADDWFC xF9,W
093E:  MOVWF  FEA
0940:  MOVF   FEF,F
0942:  BZ    095E
.................... 		i2c_write(phrase[index]);			//envoier un à un les caractères du char 
0944:  MOVF   71,W
0946:  ADDWF  xF8,W
0948:  MOVWF  FE9
094A:  MOVLW  00
094C:  ADDWFC xF9,W
094E:  MOVWF  FEA
0950:  MOVFF  FEF,FA
0954:  MOVFF  FA,FF
0958:  RCALL  07E0
.................... 		index++; 
095A:  INCF   71,F
095C:  BRA    0934
.................... 	} 
.................... 	 
.................... 	i2c_write(0x00); 
095E:  CLRF   xFF
0960:  RCALL  07E0
0962:  RETURN 0
.................... } 
.................... /*========================================================================== 
.................... ====Fonction     : writeLine		                                    ==== 
.................... ====Sierro Romain: 13.05.2016                                           ==== 
.................... ====--------------------------------------------------------------------==== 
.................... ====Affiche une ligne sur l'écran			 					 		==== 
.................... ============================================================================*/ 
.................... void writeLine(int end_xh,int end_xl, int end_yh, int end_yl) 
.................... { 
.................... 	i2c_write(0xAA);	//Commande de l'écran 
*
08B0:  MOVLW  AA
08B2:  MOVWF  xFF
08B4:  RCALL  07E0
.................... 	i2c_write(0x44);	//Commande pour dessiner 
08B6:  MOVLW  44
08B8:  MOVWF  xFF
08BA:  RCALL  07E0
.................... 	i2c_write(0x4C);	//Commande pour dessiner un trait 
08BC:  MOVLW  4C
08BE:  MOVWF  xFF
08C0:  RCALL  07E0
.................... 	i2c_write(end_xh);	//Comme l'écran est grand, sa taille se donne sur  
08C2:  MOVFF  F8,FF
08C6:  RCALL  07E0
.................... 	i2c_write(end_xl);	//2 Byte. C'est pour ça que les coordonnées sont en 2 fois 
08C8:  MOVFF  F9,FF
08CC:  RCALL  07E0
.................... 	i2c_write(end_yh);	//La ligne part de la position du curseur jusqu'à la position  
08CE:  MOVFF  FA,FF
08D2:  RCALL  07E0
.................... 	i2c_write(end_yl);	//entrée dans la fonction 
08D4:  MOVFF  FB,FF
08D8:  RCALL  07E0
08DA:  RETURN 0
.................... } 
