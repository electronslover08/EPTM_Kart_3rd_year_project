0DF4:  MOVLW  00
0DF6:  ADDWFC 03,W
0DF8:  MOVWF  FEA
0DFA:  MOVFF  FEF,FA
0DFE:  MOVFF  FA,FF
0E02:  RCALL  07E0
0E04:  INCF   71,F
0E06:  BRA    0DE6
.................... 	i2c_write(RadiusHigh); 
0E08:  MOVFF  F8,FF
0E0C:  RCALL  07E0
