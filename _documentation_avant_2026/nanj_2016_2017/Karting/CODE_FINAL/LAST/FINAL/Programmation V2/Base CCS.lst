.................... //------------------------------------------------------------------------- 
....................  
.................... #INT_EXT 
.................... void ALERT(void) 
.................... { 
.................... 	BlockRead(); 
1D58:  RCALL  1D22
.................... 	 
.................... 	if(DataRecu[1] == 0x4B){	// on appuie 
1D5A:  MOVF   xD4,W
1D5C:  SUBLW  4B
1D5E:  BNZ   1D64
.................... 		NewData = DataRecu[2];		// dis quel est l'écran à afficher 
1D60:  MOVFF  D5,D9
.................... 	} 
.................... /*	if(DataRecu[1] == 0x6B){	// on relâche 
....................  
.................... 	}*/ 
1D64:  BCF    FF2.1
1D66:  GOTO   012E
.................... } 
