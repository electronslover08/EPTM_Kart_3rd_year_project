.................... 		iCK(0x02, 0x6A, 0x00, 0xCF); 
1BF2:  MOVLW  02
1BF4:  MOVWF  xFA
1BF6:  MOVLW  6A
1BF8:  MOVWF  xFB
1BFA:  CLRF   xFC
1BFC:  MOVLW  CF
1BFE:  MOVWF  xFD
