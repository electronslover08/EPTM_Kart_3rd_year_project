.................... void iG(int img) 
.................... { 
.................... 	for(index=0; index<3; index++){	i2c_write(ig_tab[index]);} 
*
1804:  CLRF   x80
1806:  MOVF   x80,W
1808:  SUBLW  02
180A:  BNC   182A
180C:  CLRF   03
180E:  MOVF   x80,W
1810:  ADDLW  36
1812:  MOVWF  FE9
1814:  MOVLW  00
1816:  ADDWFC 03,W
1818:  MOVWF  FEA
181A:  MOVFF  FEF,F9
181E:  MOVFF  F9,FF
1822:  CALL   091E
1826:  INCF   x80,F
1828:  BRA    1806
.................... 	i2c_write(img); 
182A:  MOVFF  F8,FF
182E:  CALL   091E
1832:  RETURN 0
.................... } 
