.................... ====dans le tableau GraphVoltage_tab.									==== 
.................... ============================================================================*/ 
.................... void DrawGraphVoltageDot(void) 
.................... { 
.................... 		for (indexFor=0;indexFor<15;indexFor++) 
*
0F84:  CLRF   xE3
0F86:  MOVF   xE3,W
0F88:  SUBLW  0E
0F8A:  BTFSS  FD8.0
0F8C:  BRA    12A0
.................... 			{ 
