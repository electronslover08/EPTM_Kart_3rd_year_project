16CC:  MOVWF  xFF
16CE:  CALL   091E
.................... 		i2c_write(0x44);		//Commande pour dessiner  
16D2:  MOVLW  44
16D4:  MOVWF  xFF
16D6:  CALL   091E
.................... 		i2c_write(0x54);		//Commande pour écrire du texte 
16DA:  MOVLW  54
16DC:  MOVWF  xFF
16DE:  CALL   091E
.................... 		i2c_write(Cent+0x30);	//Affiche les centaines 
16E2:  MOVLW  30
16E4:  ADDWF  xE8,W
16E6:  MOVWF  xF8
16E8:  MOVWF  xFF
16EA:  CALL   091E
.................... 		i2c_write(Dix+0x30);	//Affiche les dizaine 
16EE:  MOVLW  30
16F0:  ADDWF  xE9,W
16F2:  MOVWF  xF8
16F4:  MOVWF  xFF
16F6:  CALL   091E
.................... 		i2c_write(0x2E);		//. 
16FA:  MOVLW  2E
16FC:  MOVWF  xFF
16FE:  CALL   091E
.................... 		i2c_write(Unit+0x30);	//Affiche les unités 
1702:  MOVLW  30
1704:  ADDWF  xEA,W
1706:  MOVWF  xF8
1708:  MOVWF  xFF
170A:  CALL   091E
.................... 		i2c_write(0x5B);		//[ 
170E:  MOVLW  5B
1710:  MOVWF  xFF
1712:  CALL   091E
.................... 		i2c_write(0x56);		//V 
1716:  MOVLW  56
1718:  MOVWF  xFF
171A:  CALL   091E
.................... 		i2c_write(0x5D);		//] 
171E:  MOVLW  5D
1720:  MOVWF  xFF
1722:  CALL   091E
.................... 		i2c_stop(); 
1726:  BSF    FC5.2
1728:  BTFSC  FC5.2
172A:  BRA    1728
172C:  GOTO   1CC0 (RETURN)
.................... } 
