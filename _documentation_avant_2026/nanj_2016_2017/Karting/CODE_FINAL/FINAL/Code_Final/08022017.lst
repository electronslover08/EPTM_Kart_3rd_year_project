.................... //  Description: dis que le uP veut commencer à lire des données 
.................... //------------------------------------------------------------------------- 
.................... void startReading(void) 
.................... { 
.................... 	int ack; 
.................... 	i2c_start(); 
*
1CD4:  BSF    FC5.1
1CD6:  BTFSC  FC5.1
1CD8:  BRA    1CD6
.................... 	 
.................... 	do{ ack = i2c_write(I2CADDRESS);} while(ack == 1); 
1CDA:  MOVLW  88
1CDC:  MOVWF  xFF
1CDE:  CALL   091E
1CE2:  MOVFF  01,F8
1CE6:  DECFSZ xF8,W
1CE8:  BRA    1CEC
1CEA:  BRA    1CDA
.................... 	do{ ack = i2c_write(0x04);}		  while(ack == 1);	// dis qu'on veut "Read Block" 
1CEC:  MOVLW  04
1CEE:  MOVWF  xFF
1CF0:  CALL   091E
1CF4:  MOVFF  01,F8
1CF8:  DECFSZ xF8,W
1CFA:  BRA    1CFE
1CFC:  BRA    1CEC
.................... 	//------------- 
.................... 	i2c_start(); 
1CFE:  BSF    FC5.1
1D00:  BTFSC  FC5.1
1D02:  BRA    1D00
.................... 	do{ ack = i2c_write(I2CADDRESS+1);}  while(ack == 1); 
1D04:  MOVLW  89
1D06:  MOVWF  xFF
1D08:  CALL   091E
1D0C:  MOVFF  01,F8
1D10:  DECFSZ xF8,W
1D12:  BRA    1D16
1D14:  BRA    1D04
1D16:  RETURN 0
.................... } 
