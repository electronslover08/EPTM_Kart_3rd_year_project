166E:  MOVWF  xFA
1670:  RCALL  12A4
1672:  MOVFF  01,E9
.................... 		Dix=Dix%10;				//-Je fais un modulo par la suite 
1676:  MOVFF  E9,F9
167A:  MOVLW  0A
167C:  MOVWF  xFA
167E:  RCALL  12A4
1680:  MOVFF  00,E9
.................... 		Unit=uri;			// 	car on ne peut pas le faire sur un double 
1684:  MOVFF  ED,EA
.................... 		Unit=Unit%10;			// 
1688:  MOVFF  EA,F9
168C:  MOVLW  0A
168E:  MOVWF  xFA
1690:  RCALL  12A4
1692:  MOVFF  00,EA
