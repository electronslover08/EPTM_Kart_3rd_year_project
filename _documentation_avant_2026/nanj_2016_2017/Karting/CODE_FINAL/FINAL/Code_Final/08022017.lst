.................... #device HIGH_INTS=TRUE 
.................... #device ICD=TRUE 
.................... #use delay(clock=20000000) 
.................... #use i2c(master,fast,sda=PIN_C4,scl=PIN_C3,FORCE_HW)	//Force à utiliser le Hardware du microcontrôleur 
*
