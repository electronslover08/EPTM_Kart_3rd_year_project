....................  
....................  
.................... void BlockRead(void) 
.................... { 
.................... 	startReading(); 
*
1D34:  RCALL  1CD4
.................... 	//récupère les valeurs de l'écran tactile 
.................... 	for(index=0; index<4; index++){ DataRecu[index] = i2c_read();} 
1D36:  CLRF   x80
1D38:  MOVF   x80,W
1D3A:  SUBLW  03
1D3C:  BNC   1D5A
1D3E:  CLRF   03
1D40:  MOVF   x80,W
1D42:  ADDLW  81
1D44:  MOVWF  FE9
1D46:  MOVLW  00
1D48:  ADDWFC 03,W
1D4A:  MOVWF  FEA
1D4C:  MOVLW  01
1D4E:  MOVWF  00
1D50:  RCALL  1D18
1D52:  MOVFF  01,FEF
1D56:  INCF   x80,F
1D58:  BRA    1D38
....................  
.................... 	DataRecu[4] = i2c_read(0); 
1D5A:  CLRF   00
1D5C:  RCALL  1D18
1D5E:  MOVFF  01,85
.................... 	i2c_stop(); 
1D62:  BSF    FC5.2
1D64:  BTFSC  FC5.2
1D66:  BRA    1D64
1D68:  RETURN 0
.................... } 
