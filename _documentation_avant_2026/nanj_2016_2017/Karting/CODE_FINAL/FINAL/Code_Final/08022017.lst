.................... //------------------------------------------------------------------------- 
.................... //  Description: commence la connection, dit le nbr de byte à envoyer 
.................... //------------------------------------------------------------------------- 
.................... void StartConnection(int NbrCharSend) 
.................... { 
.................... 	// lis la valeur de la luminosité de l'EEPROM puis on dit que c'est OldBlackLight et blacklight (les 2 doivent être égales au début) 
.................... 	i2c_start(); 
*
093A:  BSF    FC5.0
093C:  BTFSC  FC5.0
093E:  BRA    093C
.................... 	do{ ACK = i2c_write(I2CADDRESS);} while(ACK == 1); 
0940:  MOVLW  88
0942:  MOVWF  xFF
0944:  RCALL  091E
0946:  MOVFF  01,7F
094A:  DECFSZ 7F,W
094C:  BRA    0950
094E:  BRA    0940
.................... 	// envoie l'information du nombre de caractère que l'on va envoyer 
.................... 	do{ ACK = i2c_write(0x05);} while(ACK == 1); 
0950:  MOVLW  05
0952:  MOVWF  xFF
0954:  RCALL  091E
0956:  MOVFF  01,7F
095A:  DECFSZ 7F,W
095C:  BRA    0960
095E:  BRA    0950
.................... 	do{ ACK = i2c_write(NbrCharSend);} while(ACK == 1); 
0960:  MOVFF  F8,FF
0964:  RCALL  091E
0966:  MOVFF  01,7F
096A:  DECFSZ 7F,W
096C:  BRA    0970
096E:  BRA    0960
0970:  RETURN 0
.................... } 
.................... //------------------------------------------------------------------------- 
.................... //	Auteur:	Berguerand Marc 
.................... //	Date:	07.02.2014 
.................... //------------------------------------------------------------------------- 
.................... //  Description: réinitialise l'écran 
.................... //------------------------------------------------------------------------- 
.................... void reinit(void) 
.................... { 
.................... 	for(index=0; index<2; index++){	i2c_write(reinitialise[index]);} 
*
1DEE:  CLRF   x80
1DF0:  MOVF   x80,W
1DF2:  SUBLW  01
1DF4:  BNC   1E20
1DF6:  CLRF   03
1DF8:  MOVF   x80,W
1DFA:  ADDLW  2F
1DFC:  MOVWF  FE9
1DFE:  MOVLW  00
1E00:  ADDWFC 03,W
1E02:  MOVWF  FEA
1E04:  MOVFF  FEF,F1
1E08:  CLRF   19
1E0A:  BTFSC  FF2.7
1E0C:  BSF    19.7
1E0E:  BCF    FF2.7
1E10:  MOVFF  F1,FF
1E14:  CALL   091E
1E18:  BTFSC  19.7
1E1A:  BSF    FF2.7
1E1C:  INCF   x80,F
1E1E:  BRA    1DF0
1E20:  RETURN 0
.................... } 
.................... //------------------------------------------------------------------------- 
.................... //	Auteur:	Berguerand Marc 
.................... //	Date:	07.02.2014 
.................... //------------------------------------------------------------------------- 
.................... //  Description: définis un point de départ 
.................... //------------------------------------------------------------------------- 
.................... void iCK(int xH, int xL, int yH, int yL) 
.................... { 
.................... 	for(index=0; index<3; index++){	i2c_write(ick_tab[index]);} 
*
0972:  CLRF   x80
0974:  MOVF   x80,W
0976:  SUBLW  02
0978:  BNC   0996
097A:  CLRF   03
097C:  MOVF   x80,W
097E:  ADDLW  32
0980:  MOVWF  FE9
0982:  MOVLW  00
0984:  ADDWFC 03,W
0986:  MOVWF  FEA
0988:  MOVFF  FEF,FE
098C:  MOVFF  FE,FF
0990:  RCALL  091E
0992:  INCF   x80,F
0994:  BRA    0974
.................... 	i2c_write(xH); 
0996:  MOVFF  FA,FF
099A:  RCALL  091E
.................... 	i2c_write(xL); 
099C:  MOVFF  FB,FF
09A0:  RCALL  091E
.................... 	i2c_write(yH); 
09A2:  MOVFF  FC,FF
09A6:  RCALL  091E
.................... 	i2c_write(yL); 
09A8:  MOVFF  FD,FF
09AC:  RCALL  091E
09AE:  RETURN 0
.................... } 
