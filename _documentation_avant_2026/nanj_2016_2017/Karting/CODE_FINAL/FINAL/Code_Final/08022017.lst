.................... void MesAndWriteUri(void) 
.................... { 
.................... 		uri=courant*RI;	//Lit la mesure de AN1 
1656:  MOVFF  EC,ED
.................... 		Cent=uri/100;		 
165A:  MOVFF  ED,F9
