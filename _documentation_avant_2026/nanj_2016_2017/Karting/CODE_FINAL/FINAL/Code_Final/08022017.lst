.................... //  Description: écris un texte 
.................... //------------------------------------------------------------------------- 
.................... void iDT(int phrase[]) 
.................... { 
.................... 	for(index=0; index<3; index++){	i2c_write(idt_tab[index]);} 
0A7C:  CLRF   x80
0A7E:  MOVF   x80,W
0A80:  SUBLW  02
0A82:  BNC   0AA0
0A84:  CLRF   03
0A86:  MOVF   x80,W
0A88:  ADDLW  4A
0A8A:  MOVWF  FE9
0A8C:  MOVLW  00
0A8E:  ADDWFC 03,W
0A90:  MOVWF  FEA
0A92:  MOVFF  FEF,FA
0A96:  MOVFF  FA,FF
0A9A:  RCALL  091E
0A9C:  INCF   x80,F
0A9E:  BRA    0A7E
.................... 	 
.................... 	index = 0; 
0AA0:  CLRF   x80
.................... 	while(phrase[index]!=0){ 
0AA2:  MOVF   x80,W
0AA4:  ADDWF  xF8,W
0AA6:  MOVWF  FE9
0AA8:  MOVLW  00
0AAA:  ADDWFC xF9,W
0AAC:  MOVWF  FEA
0AAE:  MOVF   FEF,F
0AB0:  BZ    0ACC
.................... 		i2c_write(phrase[index]);			//envoier un à un les caractères du char 
0AB2:  MOVF   x80,W
0AB4:  ADDWF  xF8,W
0AB6:  MOVWF  FE9
0AB8:  MOVLW  00
0ABA:  ADDWFC xF9,W
0ABC:  MOVWF  FEA
0ABE:  MOVFF  FEF,FA
0AC2:  MOVFF  FA,FF
0AC6:  RCALL  091E
.................... 		index++; 
0AC8:  INCF   x80,F
0ACA:  BRA    0AA2
.................... 	} 
.................... 	 
.................... 	i2c_write(0x00); 
0ACC:  CLRF   xFF
0ACE:  RCALL  091E
0AD0:  RETURN 0
.................... } 
.................... /*========================================================================== 
.................... ====Fonction     : writeLine		                                    ==== 
.................... ====Sierro Romain: 13.05.2016                                           ==== 
.................... ====--------------------------------------------------------------------==== 
.................... ====Affiche une ligne sur l'écran			 					 		==== 
.................... ============================================================================*/ 
.................... void writeLine(int end_xh,int end_xl, int end_yh, int end_yl) 
.................... { 
.................... 	i2c_write(0xAA);	//Commande de l'écran 
*
0A1E:  MOVLW  AA
0A20:  MOVWF  xFF
0A22:  RCALL  091E
.................... 	i2c_write(0x44);	//Commande pour dessiner 
0A24:  MOVLW  44
0A26:  MOVWF  xFF
0A28:  RCALL  091E
.................... 	i2c_write(0x4C);	//Commande pour dessiner un trait 
0A2A:  MOVLW  4C
0A2C:  MOVWF  xFF
0A2E:  RCALL  091E
.................... 	i2c_write(end_xh);	//Comme l'écran est grand, sa taille se donne sur  
0A30:  MOVFF  F8,FF
0A34:  RCALL  091E
.................... 	i2c_write(end_xl);	//2 Byte. C'est pour ça que les coordonnées sont en 2 fois 
0A36:  MOVFF  F9,FF
0A3A:  RCALL  091E
.................... 	i2c_write(end_yh);	//La ligne part de la position du curseur jusqu'à la position  
0A3C:  MOVFF  FA,FF
0A40:  RCALL  091E
.................... 	i2c_write(end_yl);	//entrée dans la fonction 
0A42:  MOVFF  FB,FF
0A46:  RCALL  091E
0A48:  RETURN 0
.................... } 
