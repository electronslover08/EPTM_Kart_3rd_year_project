.................... //------------------------------------------------------------------------- 
.................... //  Description: Le bit d'ALERT est activé, ce qui signifie 
.................... //  que l'écran veut envoyer des données 
.................... //------------------------------------------------------------------------- 
....................  
1CD0:  BCF    FF2.2
1CD2:  RETFIE 1
.................... #INT_EXT 
.................... void ALERT(void) 
.................... { 
.................... 	BlockRead(); 
*
1D6A:  RCALL  1D34
.................... 	 
.................... 	if(DataRecu[1] == 0x4B){	// on appuie 
1D6C:  MOVF   x82,W
1D6E:  SUBLW  4B
1D70:  BNZ   1D76
.................... 		NewData = DataRecu[2];		// dis quel est l'écran à afficher 
1D72:  MOVFF  83,DA
.................... 	} 
.................... /*	if(DataRecu[1] == 0x6B){	// on relâche 
....................  
.................... 	}*/ 
.................... } 
....................  
....................  
.................... //timer 58u 
1D76:  BCF    FF2.1
1D78:  GOTO   012E
.................... #INT_TIMER1 
.................... Timer1_isr(){ 
....................  
.................... //	disable_interrupts(INT_TIMER1);	//Active le timer0 
.................... 	TMR1H=0xFF;	//Préchargement du timer 
1D7C:  SETF   FCF
.................... 	TMR1L=0x06;	 
1D7E:  MOVLW  06
1D80:  MOVWF  FCE
....................  
.................... 	if(Echo==1)	//Si on un toujours de l'echo 
1D82:  BTFSS  F81.2
1D84:  BRA    1D9C
.................... 	{ 
.................... 		indexEcho+=1;		//On incrémente l'index de l'echo 
1D86:  MOVLW  01
1D88:  ADDWF  xEF,F
.................... 		RD7=!RD7; 
1D8A:  BTG    F83.7
.................... //		enable_interrupts(INT_TIMER1);	//Active le timer0 
....................  
.................... 		if(indexEcho>220)	//Si l'echo à atteint la distance max 
1D8C:  MOVF   xEF,W
1D8E:  SUBLW  DC
1D90:  BC    1D9A
.................... 		{ 
.................... 			distance=220;	//On fixe la distance à 220cm 
1D92:  MOVLW  DC
1D94:  MOVWF  xF0
.................... 			indexEcho=0;	//On remet à 0 l'indexEcho 
1D96:  CLRF   xEF
.................... 			disable_interrupts(INT_TIMER1);	//Désactive timer0			 
1D98:  BCF    F9D.0
.................... 		} 
....................  
....................  
.................... 	} 
1D9A:  BRA    1DAA
.................... 	else if (Echo==0) 
1D9C:  BTFSC  F81.2
1D9E:  BRA    1DAA
.................... 	{ 
....................  
.................... 		distance=indexEcho; 
1DA0:  MOVFF  EF,F0
.................... 		indexEcho=0; 
1DA4:  CLRF   xEF
.................... 		disable_interrupts(INT_TIMER1); 
1DA6:  BCF    F9D.0
....................  
.................... RD6=!RD6; 
1DA8:  BTG    F83.6
....................  
....................  
.................... } 
.................... } 
....................  
....................  
....................  
1DAA:  BCF    F9E.0
1DAC:  GOTO   007C
.................... #INT_EXT2 
.................... void Echo_isr() 
.................... { 
.................... 	enable_interrupts(INT_TIMER1);	//Active le timer0 
1DB0:  BSF    F9D.0
.................... 	disable_interrupts(INT_EXT2);	//Désactive l'interruption RB2 
1DB2:  BCF    FF0.4
1DB4:  BCF    FF0.1
1DB6:  GOTO   007C
.................... } 
.................... /*========================================================================== 
.................... ====Fonction     : sendPulse		                                    ==== 
.................... ====Sierro Romain: 11.05.2016                                           ==== 
.................... ====--------------------------------------------------------------------==== 
.................... ====Envoie une impulsion sur le trigger du capteur				 		==== 
.................... ============================================================================*/ 
.................... void sendPulse(void) 
.................... { 
.................... 	enable_interrupts(INT_EXT2);	//Autorise l'interruption RB2 
*
1C86:  BSF    FF0.4
.................... 	Trigger=1;		//On allume l'émetteur du capteur 
1C88:  BSF    F83.1
.................... 	delay_us(10);	//pendant 10µs 
1C8A:  MOVLW  10
1C8C:  MOVWF  00
1C8E:  DECFSZ 00,F
1C90:  BRA    1C8E
1C92:  NOP   
.................... 	Trigger=0;		//Puis on l'éteint 
1C94:  BCF    F83.1
1C96:  GOTO   1CD0 (RETURN)
.................... } 
.................... /* ========================================================================= 
.................... ====Fonction     : Adc_read                                             ==== 
.................... ====Jean Nanchen : 15.09.2016                                           ==== 
.................... ====--------------------------------------------------------------------==== 
.................... ==== Fonction: int Adc_read(int channel) 
.................... ==== Déscription: Convertit en digital 8 bits le canal analog.          ==== 
.................... ==== passé en param. Paramètres d'entrée: channel: soit le canal        ==== 
.................... ==== à convertir Paramètres de sortie: valeur num. 8 bits de l'entrée   ==== 
.................... ==== analog. AN0                                                        ==== 
.................... ============================================================================ */ 
.................... int adc_read(int channel) 
.................... { 
.................... 	ADCON0 = (channel << 2) + 0b00000001; 
*
025A:  RLCF   xFC,W
025C:  MOVWF  00
025E:  RLCF   00,F
0260:  MOVLW  FC
0262:  ANDWF  00,F
0264:  MOVF   00,W
0266:  ADDLW  01
0268:  MOVWF  FC2
....................  
.................... 	ADGO = 1; 
026A:  BSF    FC2.1
.................... 	while(ADGO==1) 
026C:  BTFSS  FC2.1
026E:  BRA    0274
.................... 		continue; 
0270:  BRA    026C
0272:  BRA    026C
.................... 	return (ADRESH); 
0274:  MOVFF  FC4,01
0278:  RETURN 0
.................... } 
....................  

Configuration Fuses:
   Word  1: C200   HS FCMEN IESO
   Word  2: 1E19   NOPUT NOBROWNOUT BORV21 NOWDT WDT32768
   Word  3: 8700   CCP2C1 PBADEN LPT1OSC MCLR
   Word  4: 0000   NOSTVREN NOLVP NOXINST DEBUG
   Word  5: C00F   NOPROTECT NOCPB NOCPD
   Word  6: E00F   NOWRT NOWRTC NOWRTB NOWRTD
   Word  7: 400F   NOEBTR NOEBTRB

   Some fuses have been forced to be compatible with the ICD debugger.
