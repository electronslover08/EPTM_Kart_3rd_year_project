.................... /*========================================================================== 
.................... ====Fonction     : SavaVoltageData                                      ==== 
.................... ====Jean Nanchen: 11.12.2016                                            ==== 
.................... ====--------------------------------------------------------------------==== 
.................... ====Chaque 10secondes, on mémorise à l'emplacement 15 la tension,       ==== 
.................... ====on décale la tension de -1 emplacement dans le tableau				==== 
.................... ============================================================================*/ 
.................... void SaveVoltageData(void) 
.................... { 
.................... if (idelay==10) //Rentre dans le if chaque 10secondes 
*
07E0:  MOVF   xEE,W
07E2:  SUBLW  0A
07E4:  BTFSS  FD8.2
07E6:  BRA    0918
.................... { 
....................  
.................... 	idelay=0; //reset 
07E8:  CLRF   xEE
.................... 	 
.................... 	GraphVoltage_tab[15]=(adc_read(AnalTension)-212)*5.93+(((adc_read(AnalCourant))/8.5)*RI);	//La première partie [(adc_read(AnalTension)-212)*5.93] prend en compte que la plage varie de 48V à 57.6V 
07EA:  MOVLW  01
07EC:  MOVWF  xFC
07EE:  RCALL  025A
07F0:  MOVLW  D4
07F2:  SUBWF  01,W
07F4:  CLRF   xFE
07F6:  MOVWF  xFD
07F8:  RCALL  027A
07FA:  MOVFF  03,103
07FE:  MOVFF  02,102
0802:  MOVFF  01,101
0806:  MOVFF  00,100
080A:  MOVLW  8F
080C:  MOVLB  1
080E:  MOVWF  x07
0810:  MOVLW  C2
0812:  MOVWF  x06
0814:  MOVLW  3D
0816:  MOVWF  x05
0818:  MOVLW  81
081A:  MOVWF  x04
081C:  MOVLB  0
081E:  RCALL  02B0
0820:  MOVFF  03,FB
0824:  MOVFF  02,FA
0828:  MOVFF  01,F9
082C:  MOVFF  00,F8
0830:  CLRF   xFC
0832:  RCALL  025A
0834:  CLRF   xFE
0836:  MOVFF  01,FD
083A:  RCALL  027A
083C:  MOVFF  03,100
0840:  MOVFF  02,FF
0844:  MOVFF  01,FE
0848:  MOVFF  00,FD
084C:  MOVLB  1
084E:  CLRF   x04
0850:  CLRF   x03
0852:  MOVLW  08
0854:  MOVWF  x02
0856:  MOVLW  82
0858:  MOVWF  x01
085A:  MOVLB  0
085C:  RCALL  03A6
085E:  MOVFF  03,FF
0862:  MOVFF  02,FE
0866:  MOVFF  01,FD
086A:  MOVFF  00,FC
086E:  MOVFF  03,103
0872:  MOVFF  02,102
0876:  MOVFF  01,101
087A:  MOVFF  00,100
087E:  MOVLB  1
0880:  CLRF   x07
0882:  CLRF   x06
0884:  CLRF   x05
0886:  MOVLW  7F
0888:  MOVWF  x04
088A:  MOVLB  0
088C:  RCALL  02B0
088E:  MOVFF  FEA,FD
0892:  MOVFF  FE9,FC
0896:  BCF    FD8.1
0898:  MOVFF  FB,102
089C:  MOVFF  FA,101
08A0:  MOVFF  F9,100
08A4:  MOVFF  F8,FF
08A8:  MOVFF  03,106
08AC:  MOVFF  02,105
08B0:  MOVFF  01,104
08B4:  MOVFF  00,103
08B8:  RCALL  0522
08BA:  MOVFF  FD,FEA
08BE:  MOVFF  FC,FE9
08C2:  MOVFF  03,102
08C6:  MOVFF  02,101
08CA:  MOVFF  01,100
08CE:  MOVFF  00,FF
08D2:  RCALL  07A4
08D4:  MOVFF  01,7F
.................... 																								//Donc si la batterie est à 48V, la valeur numérique sera de 0, et si la batterie est pleine 
.................... 																								//la valeur numérique sera de 255, c'est juste une histoire d'amplification de courbe 
.................... 																								// 
.................... 																								//La deuxième partie sert d'additionner la tension aux borne de la résistance interne quand on tire du courant 
.................... 																								//Car sinon on verrais la tension du karting chuter quand on tire du courant, la on contre cela, la formule c'est U=R*I 
....................  
.................... //Ici, on prend la valeur à l'emplacement par exemple 15 et on la décale à l'emplacement 14 
.................... //On fait cela pour toutes les valeurs ce qi permet de pouvoir faire défiler chaque 10 secondes 
.................... //La courbe. 
.................... 	for (indexTimer=1;indexTimer<16;indexTimer++) 
08D8:  MOVLW  01
08DA:  MOVWF  xD7
08DC:  MOVF   xD7,W
08DE:  SUBLW  0F
08E0:  BNC   0916
.................... 	{ 
.................... 		GraphVoltage_tab[indexTimer-1]=GraphVoltage_tab[indexTimer]; 
08E2:  MOVLW  01
08E4:  SUBWF  xD7,W
08E6:  CLRF   03
08E8:  ADDLW  70
08EA:  MOVWF  01
08EC:  MOVLW  00
08EE:  ADDWFC 03,F
08F0:  MOVFF  03,F9
08F4:  CLRF   03
08F6:  MOVF   xD7,W
08F8:  ADDLW  70
08FA:  MOVWF  FE9
08FC:  MOVLW  00
08FE:  ADDWFC 03,W
0900:  MOVWF  FEA
0902:  MOVFF  FEF,FA
0906:  MOVFF  F9,FEA
090A:  MOVFF  01,FE9
090E:  MOVFF  FA,FEF
0912:  INCF   xD7,F
0914:  BRA    08DC
.................... 	} 
....................  
.................... } 
0916:  BRA    091A
.................... else 
.................... { 
.................... idelay++; //On incrémente 
0918:  INCF   xEE,F
.................... } 
091A:  GOTO   1CA6 (RETURN)
....................  
.................... } 
.................... /*========================================================================== 
.................... ====Fonction     : SavaVoltageData                                      ==== 
