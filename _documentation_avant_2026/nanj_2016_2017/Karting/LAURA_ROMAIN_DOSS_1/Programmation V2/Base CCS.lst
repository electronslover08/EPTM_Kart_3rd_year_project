.................... ====Démarre la connection avec l'écran							 		==== 
.................... ============================================================================*/ 
.................... void startConnection(int charToSend) 
.................... { 
.................... 	i2c_start(); 
*
0790:  BSF    FC5.0
0792:  BTFSC  FC5.0
0794:  BRA    0792
.................... 	do{ACK = i2c_write(I2CADDRESS);}	while(ACK==1);	//Atteindre l'écran 
0796:  MOVLW  88
0798:  MOVWF  75
079A:  RCALL  0774
079C:  MOVFF  01,20
07A0:  DECFSZ 20,W
07A2:  BRA    07A6
07A4:  BRA    0796
.................... 	do{ACK = i2c_write(0x05);}			while(ACK==1);	//Dire à l'écran que l'on veut lui envoyer qqch 
07A6:  MOVLW  05
07A8:  MOVWF  75
07AA:  RCALL  0774
07AC:  MOVFF  01,20
07B0:  DECFSZ 20,W
07B2:  BRA    07B6
07B4:  BRA    07A6
.................... 	do{ACK = i2c_write(charToSend);}	while(ACK==1);	//Dire à l'écran combien de char on lui envoie 	 
07B6:  MOVFF  71,75
07BA:  RCALL  0774
07BC:  MOVFF  01,20
07C0:  DECFSZ 20,W
07C2:  BRA    07C6
07C4:  BRA    07B6
07C6:  RETURN 0
.................... } 
