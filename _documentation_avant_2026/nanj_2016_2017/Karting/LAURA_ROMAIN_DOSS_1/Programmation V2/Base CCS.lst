04F0:  MOVWF  FCE
.................... 	if(Echo==1)	//Si on un toujours de l'echo 
04F2:  BTFSS  F81.2
04F4:  BRA    0558
.................... 	{ 
.................... 		indexEcho+=1;		//On incrémente l'index de l'echo 
04F6:  BCF    FD8.1
04F8:  MOVFF  1D,6C
04FC:  MOVFF  1C,6B
0500:  MOVFF  1B,6A
0504:  MOVFF  1A,69
0508:  CLRF   70
050A:  CLRF   6F
050C:  CLRF   6E
050E:  MOVLW  7F
0510:  MOVWF  6D
0512:  BRA    00E0
0514:  MOVFF  03,1D
0518:  MOVFF  02,1C
051C:  MOVFF  01,1B
0520:  MOVFF  00,1A
.................... 		if(indexEcho==470)	//Si l'echo à atteint la distance max 
0524:  MOVFF  1D,6C
0528:  MOVFF  1C,6B
052C:  MOVFF  1B,6A
0530:  MOVFF  1A,69
0534:  CLRF   70
0536:  CLRF   6F
0538:  MOVLW  6B
053A:  MOVWF  6E
053C:  MOVLW  87
053E:  MOVWF  6D
0540:  RCALL  034C
0542:  BNZ   0556
.................... 		{ 
.................... 			distance=400;	//On fixe la distance à 4m 
0544:  MOVLW  01
0546:  MOVWF  1F
0548:  MOVLW  90
054A:  MOVWF  1E
.................... 			indexEcho=0;	//On remet à 0 l'indexEcho 
054C:  CLRF   1D
054E:  CLRF   1C
0550:  CLRF   1B
0552:  CLRF   1A
.................... 			disable_interrupts(INT_TIMER1);	//Désactive timer0			 
0554:  BCF    F9D.0
.................... 		} 
.................... 	} 
0556:  BRA    05B6
.................... 	else 
.................... 	{ 
.................... 		distance = indexEcho*0.85;		//(((indexEcho*0.00005)*340)/2)*100;		 
0558:  MOVFF  1D,74
055C:  MOVFF  1C,73
0560:  MOVFF  1B,72
0564:  MOVFF  1A,71
0568:  MOVLW  9A
056A:  MOVWF  78
056C:  MOVLW  99
056E:  MOVWF  77
0570:  MOVLW  59
0572:  MOVWF  76
0574:  MOVLW  7E
0576:  MOVWF  75
0578:  RCALL  03C2
057A:  MOVFF  03,74
057E:  MOVFF  02,73
0582:  MOVFF  01,72
0586:  MOVFF  00,71
058A:  RCALL  04B4
058C:  MOVFF  02,1F
0590:  MOVFF  01,1E
.................... 		if(distance>=400){distance=400;}	//Fixe la distance max à 4m 
0594:  MOVF   1F,W
0596:  SUBLW  00
0598:  BC    05AC
059A:  XORLW  FF
059C:  BNZ   05A4
059E:  MOVF   1E,W
05A0:  SUBLW  8F
05A2:  BC    05AC
05A4:  MOVLW  01
05A6:  MOVWF  1F
05A8:  MOVLW  90
05AA:  MOVWF  1E
.................... 		indexEcho=0;	//Remet à 0 indexEcho 
05AC:  CLRF   1D
05AE:  CLRF   1C
05B0:  CLRF   1B
05B2:  CLRF   1A
.................... 		disable_interrupts(INT_TIMER1);	//Désactive timer0 
05B4:  BCF    F9D.0
.................... 	} 
.................... } 
....................  
.................... //Timer : chaque seconde, appelle la fonction vitesse 
05B6:  BCF    F9E.0
05B8:  GOTO   0088
.................... #INT_TIMER2 
.................... void TIMER2_isr() 
.................... { 
.................... 	static int i_sec; 
.................... 	 
.................... 	TMR2=240; 
*
0992:  MOVLW  F0
0994:  MOVWF  FCC
.................... 	if(i_sec==100)	//Chaque seconde, on calcule la vitesse 
0996:  MOVF   5A,W
0998:  SUBLW  64
099A:  BNZ   09A2
.................... 	{ 
.................... 		i_sec=0; 
099C:  CLRF   5A
.................... 		mesVitesse();	//Mesure et affiche la vitesse du karting	 
099E:  BRA    0814
.................... 	} 
09A0:  BRA    09A4
.................... 	else 
.................... 	{ 
.................... 		i_sec++; 
09A2:  INCF   5A,F
.................... 	} 
09A4:  BCF    F9E.1
09A6:  GOTO   0088
.................... } 
