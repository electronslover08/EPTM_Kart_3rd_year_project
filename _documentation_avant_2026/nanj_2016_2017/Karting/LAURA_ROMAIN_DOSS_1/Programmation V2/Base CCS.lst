.................... /* ========================================================================= 
.................... ====Fonction     : Adc_read                                             ==== 
.................... ====Sierro Romain: 07.01.2014                                           ==== 
.................... ====--------------------------------------------------------------------==== 
.................... ==== Fonction: int Adc_read(int channel) 
.................... ==== Déscription: Convertit en digital 8 bits le canal analog.          ==== 
.................... ==== passé en param. Paramètres d'entrée: channel: soit le canal        ==== 
.................... ==== à convertir Paramètres de sortie: valeur num. 8 bits de l'entrée   ==== 
.................... ==== analog. AN0                                                        ==== 
.................... ============================================================================ */ 
.................... int adc_read(int channel) 
.................... { 
.................... 	ADCON0 = (channel << 2) + 0b00000001; 
*
0F94:  RLCF   5B,W
0F96:  MOVWF  00
0F98:  RLCF   00,F
0F9A:  MOVLW  FC
0F9C:  ANDWF  00,F
0F9E:  MOVF   00,W
0FA0:  ADDLW  01
0FA2:  MOVWF  FC2
....................  
.................... 	ADGO = 1; 
0FA4:  BSF    FC2.1
.................... 	while(ADGO==1) 
0FA6:  BTFSS  FC2.1
0FA8:  BRA    0FAE
.................... 		continue; 
0FAA:  BRA    0FA6
0FAC:  BRA    0FA6
.................... 	return (ADRESH); 
0FAE:  MOVFF  FC4,01
0FB2:  RETURN 0
.................... } 
