.................... ====Fonction     : sendPulse		                                    ==== 
.................... ====Sierro Romain: 11.05.2016                                           ==== 
.................... ====--------------------------------------------------------------------==== 
.................... ====Envoie une impulsion sur le trigger du capteur				 		==== 
.................... ============================================================================*/ 
.................... void sendPulse(void) 
.................... { 
.................... 	Trigger=1;		//On allume l'émetteur du capteur 
0D70:  BSF    F83.1
.................... 	delay_us(10);	//pendant 10µs 
0D72:  MOVLW  10
0D74:  MOVWF  00
0D76:  DECFSZ 00,F
0D78:  BRA    0D76
0D7A:  NOP   
.................... 	Trigger=0;		//Puis on l'éteint 
0D7C:  BCF    F83.1
0D7E:  GOTO   16BA (RETURN)
.................... } 
