0978:  MOVWF  75
097A:  RCALL  0774
.................... 	i2c_write(0x68);		//h  
097C:  MOVLW  68
097E:  MOVWF  75
0980:  RCALL  0774
.................... 	i2c_write(0x5D);		//] 
0982:  MOVLW  5D
0984:  MOVWF  75
0986:  RCALL  0774
.................... 	i2c_stop(); 
0988:  BSF    FC5.2
098A:  BTFSC  FC5.2
098C:  BRA    098A
098E:  GOTO   09A0 (RETURN)
.................... } 
