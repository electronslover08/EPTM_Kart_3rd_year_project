<CasDocument DocVersion="4.0"><Entries ZoomFactor="1"><Entry Id="0" NumberField="Real" TrigUnit="Degrees"><Type>Equation</Type><Sub Type="input" Width="1649" Height="47"><Formula>SymbolicSolve[List[Equal[3.5,Product[5,Aggregate[Divide[d,Sum[c,d]]],Aggregate[Sum[1,Divide[a,b]]]]],Equal[4.75,Sum[3.5,Product[5,Aggregate[Divide[a,b]]]]],Equal[2.25,Minus[3.5,Product[5,Aggregate[Divide[a,b]]]]]],List[c,a,d]]</Formula></Sub><Sub Type="output" Width="1649" Height="103"><Formula>Solution[{c,ExpressionSetPoint[ExpressionWithCondition[Divide[Product[11,d],14],NotEqual[b,0]],False,ReservedReal]},{a,ExpressionSetPoint[ExpressionWithCondition[Divide[b,4],NotEqual[b,0]],False,ReservedReal]},{d,ExpressionWithCondition[ReservedReal,NotEqual[b,0]]}]</Formula></Sub></Entry></Entries><Assignments /></CasDocument>