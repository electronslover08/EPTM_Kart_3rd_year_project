.................... //Fonction : envoie une impulsion sur le trigger du capteur 
.................... void sendPulse(void) 
.................... { 
.................... 	Trigger=1; 
*
0486:  BSF    F83.0
.................... 	delay_us(10); 
0488:  MOVLW  10
048A:  MOVWF  00
048C:  DECFSZ 00,F
048E:  BRA    048C
0490:  NOP   
.................... 	Trigger=0;	 
0492:  BCF    F83.0
.................... } 
