04F4:  MOVWF  40
04F6:  RCALL  04C0
04F8:  MOVFF  01,1C
04FC:  DECFSZ 1C,W
04FE:  BRA    0502
0500:  BRA    04F2
.................... 	do{ACK = i2c_write(charToSend);}	while(ACK==1);	//Dire à l'écran combien de char on lui envoie 	 
0502:  MOVFF  3F,40
0506:  RCALL  04C0
0508:  MOVFF  01,1C
050C:  DECFSZ 1C,W
050E:  BRA    0512
0510:  BRA    0502
