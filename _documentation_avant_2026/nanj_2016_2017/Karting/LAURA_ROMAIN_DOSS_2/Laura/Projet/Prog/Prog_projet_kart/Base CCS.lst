00C2:  MOVWF  FD6
.................... 	enable_interrupts(INT_TIMER0); 
00C4:  BSF    FF2.5
.................... } 
....................  
.................... //Timer : sert à mesurer la longueur de la pulse d'Echo et ainsi, à calculer la distance 
00C6:  BCF    FF2.1
00C8:  RETFIE 1
.................... #INT_TIMER0 
.................... void TIMER0_isr() 
.................... { 
