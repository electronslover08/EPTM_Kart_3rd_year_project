....................  
.................... //Interruption : s'active à chaque fois qu'un signal arrive sur la pin Echo 
.................... #INT_EXT FAST 
.................... void Echo_isr() 
.................... { 
.................... 	TMR0H=0xFF; 
*
00BE:  SETF   FD7
.................... 	TMR0L=0x06; 
