.................... /*========================================================================== 
.................... ====Fonction     :Config_uP                                             ==== 
.................... ====Auteur : Sidler Laura 												==== 
.................... ====Date : 16.12.2014                                    				==== 
.................... ====------------------------------------------------------------------	==== 
.................... ==== Configure les ports du microprocesseur								==== 
.................... ====------------------------------------------------------------------	==== 
.................... ==== ADCON : registres du convertisseur AD/DA							==== 
.................... ==== TRIS  : ports d'entrée ou sortie du PIC 							==== 
.................... ====------------------------------------------------------------------	==== 
.................... ==== return : void												        ==== 
.................... ============================================================================*/ 
.................... void Config_uP(void) 
.................... { 
033A:  BRA    033A
.................... 	//Timer 
.................... 	enable_interrupts(GLOBAL); 
*
02AA:  MOVLW  C0
02AC:  IORWF  FF2,F
.................... 	enable_interrupts(INT_TIMER0);	ext_int_edge(L_to_H);	//Configure RB0 sur le flanc montant	 
02AE:  BSF    FF2.5
02B0:  BSF    FF1.6
....................     enable_interrupts(INT_EXT);      						// autorise l'interruptionRB0 (INTERRUPT0) 
02B2:  BSF    FF2.4
.................... 	T0CON = 0b00000111;										// TMR0 enable, 8 bits, PS assigned at 256 
02B4:  MOVLW  07
02B6:  MOVWF  FD5
....................  
.................... 	//PORTS 
.................... 	TRISA = 0x00; 
02B8:  CLRF   F92
.................... 	TRISB = 0b00000111; 
02BA:  MOVWF  F93
.................... 	TRISC = 0x00; 
02BC:  CLRF   F94
.................... 	TRISD = 0x00; 
02BE:  CLRF   F95
....................  
.................... 	//Convertisseur AD /!\ changer la configuration d'une fois que j'aurais fait le schéma ou utiliser la même configuration hardware /!\ 
.................... 	ADCON0=0x01;		//Configuration des registre de conversion A/D	 
02C0:  MOVLW  01
02C2:  MOVWF  FC2
.................... 	ADCON1=0x0E;		//PORTA en analogique (pot) 
02C4:  MOVLW  0E
02C6:  MOVWF  FC1
.................... 	ADCON2=0x1D; 
02C8:  MOVLW  1D
02CA:  MOVWF  FC0
....................  
.................... 	/*Lire la valeur de l'EEPROM 
.................... 	startConnection(5); 
.................... 	readEeprom(0x00);					//iER 
.................... 	i2c_stop(); 
.................... 	//lis l'information désirée 
.................... 	backlight = dataRecuTab[2];			//savoir la valeur 
.................... 	oldBackLight = backlight;*/	 
.................... }//------------------------------------------------------------------------------ 
02CC:  GOTO   0338 (RETURN)
....................  
