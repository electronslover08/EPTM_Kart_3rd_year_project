.................... 		{i2c_write(initTab[index]);} 
.................... } 
....................  
.................... //Fonction : démarre la connection avec l'écran 
.................... void startConnection(int charToSend) 
.................... { 
.................... 	i2c_start(); 
*
0196:  BSF    FC5.0
0198:  BTFSC  FC5.0
019A:  BRA    0198
.................... 	do{ACK = i2c_write(I2CADDRESS);}	while(ACK==1);	//Atteindre l'écran 
019C:  MOVLW  88
019E:  MOVWF  x90
01A0:  RCALL  017A
01A2:  MOVFF  01,34
01A6:  DECFSZ 34,W
01A8:  BRA    01AC
01AA:  BRA    019C
.................... 	do{ACK = i2c_write(0x05);}			while(ACK==1);	//Dire à l'écran que l'on veut lui envoyer des char 
01AC:  MOVLW  05
01AE:  MOVWF  x90
01B0:  RCALL  017A
01B2:  MOVFF  01,34
01B6:  DECFSZ 34,W
01B8:  BRA    01BC
01BA:  BRA    01AC
.................... 	do{ACK = i2c_write(charToSend);}	while(ACK==1);	//Dire à l'écran combien de char on lui envoie 	 
01BC:  MOVFF  8B,90
01C0:  RCALL  017A
01C2:  MOVFF  01,34
01C6:  DECFSZ 34,W
01C8:  BRA    01CC
01CA:  BRA    01BC
.................... } 
01CC:  GOTO   0272 (RETURN)
