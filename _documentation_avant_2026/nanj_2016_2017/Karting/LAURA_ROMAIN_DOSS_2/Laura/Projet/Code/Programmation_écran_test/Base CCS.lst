0274:  MOVLW  AA
0276:  MOVWF  x8C
0278:  CLRF   x8D
027A:  MOVLW  96
027C:  MOVWF  x8E
027E:  BRA    01D0
.................... 	strcpy(textTab, "ce code marche !"); 
0280:  CLRF   FEA
0282:  MOVLW  45
0284:  MOVWF  FE9
0286:  MOVLW  00
0288:  RCALL  0158
028A:  TBLRD*-
028C:  TBLRD*+
028E:  MOVF   FF5,W
0290:  MOVWF  FEE
0292:  IORLW  00
0294:  BNZ   028C
.................... 	writeText(textTab); 
0296:  CLRF   x8C
0298:  MOVLW  45
029A:  MOVWF  x8B
029C:  BRA    0210
.................... 	i2c_stop(); 
029E:  BSF    FC5.2
02A0:  BTFSC  FC5.2
02A2:  BRA    02A0
.................... } 
