02A6:  GOTO   010A
.................... void startPointScreen(int xH, int xL, int yH, int yL) //x, y = axe. 
.................... { 
.................... 	for(index=0; index<3; index++) 
*
01D0:  CLRF   31
01D2:  MOVF   31,W
01D4:  SUBLW  02
01D6:  BNC   01F4
.................... 		{i2c_write(startPointTab[index]);} 
01D8:  CLRF   03
01DA:  MOVF   31,W
01DC:  ADDLW  3D
01DE:  MOVWF  FE9
01E0:  MOVLW  00
01E2:  ADDWFC 03,W
01E4:  MOVWF  FEA
01E6:  MOVFF  FEF,8F
01EA:  MOVFF  8F,90
01EE:  RCALL  017A
01F0:  INCF   31,F
01F2:  BRA    01D2
.................... 	i2c_write(xH); 
01F4:  MOVFF  8B,90
01F8:  RCALL  017A
.................... 	i2c_write(yH); 
01FA:  MOVFF  8D,90
01FE:  RCALL  017A
.................... 	i2c_write(xL); 
0200:  MOVFF  8C,90
0204:  RCALL  017A
.................... 	i2c_write(yL); 
0206:  MOVFF  8E,90
020A:  RCALL  017A
.................... } 
020C:  GOTO   0280 (RETURN)
