.................... //Fonction : écrire une phrase 
.................... void writeText(int textTab[]) 
.................... { 
.................... 	for(index=0; index<3; index++) 
*
0210:  CLRF   31
0212:  MOVF   31,W
0214:  SUBLW  02
0216:  BNC   0234
.................... 		{i2c_write(writeTextTab[index]);} 
0218:  CLRF   03
021A:  MOVF   31,W
021C:  ADDLW  41
021E:  MOVWF  FE9
0220:  MOVLW  00
0222:  ADDWFC 03,W
0224:  MOVWF  FEA
0226:  MOVFF  FEF,8D
022A:  MOVFF  8D,90
022E:  RCALL  017A
0230:  INCF   31,F
0232:  BRA    0212
.................... 	index=0; 
0234:  CLRF   31
.................... 	while(textTab[index]!=0) 
.................... 		{i2c_write(textTab[index]); 
0236:  CLRF   03
0238:  MOVF   31,W
023A:  ADDWF  x8B,W
023C:  MOVWF  FE9
023E:  MOVF   x8C,W
0240:  ADDWFC 03,W
0242:  MOVWF  FEA
0244:  MOVF   FEF,F
0246:  BZ    0264
0248:  CLRF   03
024A:  MOVF   31,W
024C:  ADDWF  x8B,W
024E:  MOVWF  FE9
0250:  MOVF   x8C,W
0252:  ADDWFC 03,W
0254:  MOVWF  FEA
0256:  MOVFF  FEF,8D
025A:  MOVFF  8D,90
025E:  RCALL  017A
.................... 		 index++;} 
0260:  INCF   31,F
0262:  BRA    0236
.................... 	i2c_write(0x00); 
0264:  CLRF   x90
0266:  RCALL  017A
.................... } 
0268:  GOTO   029E (RETURN)

Configuration Fuses:
   Word  1: C200   HS FCMEN IESO
   Word  2: 1E19   NOPUT NOBROWNOUT BORV20 NOWDT WDT32768
   Word  3: 8500   CCP2C1 NOPBADEN LPT1OSC MCLR
   Word  4: 0000   NOSTVREN NOLVP NOXINST DEBUG
   Word  5: C00F   NOPROTECT NOCPB NOCPD
   Word  6: E00F   NOWRT NOWRTC NOWRTB NOWRTD
   Word  7: 400F   NOEBTR NOEBTRB

   Some fuses have been forced to be compatible with the ICD debugger.
