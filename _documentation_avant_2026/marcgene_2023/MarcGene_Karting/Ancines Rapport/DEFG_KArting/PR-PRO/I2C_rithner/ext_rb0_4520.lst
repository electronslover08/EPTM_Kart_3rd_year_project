00D8:  MOVWF  1B
00DA:  RCALL  00AE
.................... 	i2c_write(0x51); 
00DC:  MOVLW  51
00DE:  MOVWF  1B
00E0:  RCALL  00AE
....................  
.................... 		i2c_stop(); 
00E2:  BSF    FC5.2
00E4:  BTFSC  FC5.2
00E6:  BRA    00E4
.................... } 
