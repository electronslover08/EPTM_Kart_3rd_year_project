0128:  BSF    FF2.7
012A:  CLRF   19
012C:  BTFSC  FF2.7
012E:  BSF    19.7
0130:  BCF    FF2.7
....................    i2c_write(0x52); 
0132:  MOVLW  52
0134:  MOVWF  1B
0136:  RCALL  00AE
0138:  BTFSC  19.7
013A:  BSF    FF2.7
013C:  CLRF   19
013E:  BTFSC  FF2.7
0140:  BSF    19.7
0142:  BCF    FF2.7
....................    i2c_write(0x1E); 
0144:  MOVLW  1E
0146:  MOVWF  1B
0148:  RCALL  00AE
014A:  BTFSC  19.7
014C:  BSF    FF2.7
014E:  CLRF   19
0150:  BTFSC  FF2.7
0152:  BSF    19.7
0154:  BCF    FF2.7
....................    i2c_write(0xFE); 
